{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qcore-solutions-landing",
  "compatibility_date": "2026-09-08",
  // qcore-solutions.com is served by the Cloudflare Pages project
  // "qcore-solutions" (see build-pages.sh), not by this Worker, so no
  // custom-domain routes are declared here. Both the *.workers.dev URL
  // and preview URLs are off deliberately.
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    // Serve only the assembled output. Pointing this at "." would publish
    // the whole repo, including design-source/ and README.md.
    "directory": "dist"
  }
}
